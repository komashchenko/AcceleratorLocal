set(SOURCESDK_DIR "${PROJECT_SOURCE_DIR}/third_party/sourcesdk" CACHE PATH "Source SDK checkout")

set(SOURCESDK_GAME_TARGET cs2 CACHE STRING "Source SDK game target" FORCE)
set(SOURCESDK_AM_DEFINES ON CACHE BOOL "Use AlliedModders definitions" FORCE)
set(SOURCESDK_COMPILE_PROTOBUF OFF CACHE BOOL "Build Source SDK protobufs" FORCE)
set(SOURCESDK_CONFIGURE_EXPORT_MAP ON CACHE BOOL "Use Source SDK export map" FORCE)
set(SOURCESDK_ENABLE_TESTS OFF CACHE BOOL "Build Source SDK tests" FORCE)
set(SOURCESDK_LINK_ENABLE_RPATH OFF CACHE BOOL "Add Source SDK RPATH" FORCE)
set(SOURCESDK_LINK_STEAMWORKS OFF CACHE BOOL "Link Steamworks" FORCE)
set(SOURCESDK_LINK_STRIP_CPP_EXPORTS ON CACHE BOOL "Avoid C++ runtime exports from linked SDK libraries" FORCE)
set(SOURCESDK_LINK_STRIP_SYMBOLS OFF CACHE BOOL "Strip Source SDK symbols" FORCE)
set(SOURCESDK_MALLOC_OVERRIDE OFF CACHE BOOL "Use Valve allocator overrides" FORCE)
set(SOURCESDK_USE_ABI0 ON CACHE BOOL "Use the Source 2 compatible C++ ABI" FORCE)

add_subdirectory("${SOURCESDK_DIR}" sourcesdk EXCLUDE_FROM_ALL)
